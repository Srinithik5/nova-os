# Read server-side only by next.config.js's rewrite proxy — never shipped
# to the browser bundle. Copy to .env.local for local development.
BACKEND_URL=http://localhost:4000

# Must match backend/.env's JWT_ACCESS_SECRET exactly — middleware.ts
# verifies the access token's signature locally instead of calling the
# backend on every navigation (blueprint §6).
JWT_ACCESS_SECRET=dev_access_secret_change_me